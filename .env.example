# Set in Vercel (Project > Settings > Environment Variables). Never commit real values.

# Neon Postgres: website content, saved versions and enquiries (tables in db/schema.sql)
DATABASE_URL=

# Private Vercel Blob store "sra-cms" for uploaded photos (created automatically when connected)
BLOB_READ_WRITE_TOKEN=

# Used once by the seed command to create the first admin account.
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# Required for signed user sessions. Generate a random 32+ character value.
JWT_SECRET=

# Required later for encrypted accounting settings.
ENCRYPTION_KEY=

# Phase 3: server-side only; used to analyse private site photos.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
