# Set in Vercel (Project > Settings > Environment Variables). Never commit real values.

# Neon Postgres: website content, saved versions and enquiries (tables in db/schema.sql)
DATABASE_URL=

# Private Vercel Blob store "sra-cms" for uploaded photos (created automatically when connected)
BLOB_READ_WRITE_TOKEN=

# Password for https://<site>/admin
ADMIN_PASSWORD=
